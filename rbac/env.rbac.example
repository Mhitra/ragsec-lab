# Experiment 18 with a Neo4j Desktop DBMS. Copy these lines into .env (keep a backup of the current .env first).
# App account (restricted, created by rbac/setup_rbac.cypher):
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USERNAME=ragapp
NEO4J_PASSWORD=<the password you set with :param password>
NEO4J_DATABASE=neo4j
# Admin account, used only by scripts/run_attacks.py to reseed and to read the database state:
PROBE_NEO4J_URI=bolt://localhost:7687
PROBE_NEO4J_USERNAME=neo4j
PROBE_NEO4J_PASSWORD=<the DBMS admin password from Neo4j Desktop>
