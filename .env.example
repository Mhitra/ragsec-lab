# Copy this file to .env and fill it in. Never commit .env.
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USERNAME=XXXXXXXX
NEO4J_PASSWORD=
NEO4J_DATABASE=XXXXXXXX

# Ollama (running on the host machine). host.docker.internal lets the container reach it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
PROTECT_EXCLUDE_SECRET=0
PROTECT_VALIDATE=0
PROTECT_READONLY=0
DEBUG_ERRORS=0